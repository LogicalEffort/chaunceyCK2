{
    "pageid": 3321,
    "title": "Crusader Kings: Chronicles",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Crusader Kings: Chronicles is a spin-off interactive novel released shortly before The Reaper's Due . It unlocks an exclusive song called “Guy de Rose’s Quandry” and two exclusive events chains for Crusader Kings 2 . It also has a eBook reader and 6 books available for purchase, or available for no cost if the user already owns the eBooks from the main game."
                },
                {
                    "type": "paragraph",
                    "text": "Important: This mobile app is no longer available on iOS or android. This was announced after speculation on the forum: bottom of page"
                },
                {
                    "type": "paragraph",
                    "text": "With the release of patch 3.0, the exclusive event chains and song were made available to everyone."
                }
            ]
        },
        {
            "heading": "Minimum requirements",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "iOS: iPad® Air™ or newer, iPad® 2 or newer, iPad® mini™ or newer, iPhone® 4s or newer, iPod Touch® 5 or newer. iOS version 6.0.",
                            "children": []
                        },
                        {
                            "text": "Android: Android 5.0 (API level 21), 320x200 pixel resolution, 512Mb memory,",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Accessing eBooks",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "The player must connect his/her Paradox account and Steam account.",
                            "children": []
                        },
                        {
                            "text": "Go to accounts.paradoxplaza.com",
                            "children": []
                        },
                        {
                            "text": "Log in",
                            "children": []
                        },
                        {
                            "text": "Click Settings",
                            "children": []
                        },
                        {
                            "text": "Click ”Connect” Steam account and follow the instructions.",
                            "children": []
                        },
                        {
                            "text": "When the player logs into his/her Paradox account in the mobile app – the content is unlocked.",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "paragraph",
                    "text": "If the content is not unlocked, check the following:"
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Have you connected you Paradox account and Steam Account?",
                            "children": []
                        },
                        {
                            "text": "Have you logged in to the Paradox Account in the mobile app?",
                            "children": []
                        },
                        {
                            "text": "It doesn’t work – help?",
                            "children": []
                        },
                        {
                            "text": "Go to the Support page and create a ticket",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Accessing extra content",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "The new content will be released on August 25, 2016.",
                            "children": []
                        },
                        {
                            "text": "The player must connect his/her Paradox account and Steam account.",
                            "children": []
                        },
                        {
                            "text": "Go to accounts.paradoxplaza.com",
                            "children": []
                        },
                        {
                            "text": "Log in",
                            "children": []
                        },
                        {
                            "text": "Click Settings",
                            "children": []
                        },
                        {
                            "text": "Click ”Connect” your Steam account and follow the instructions.",
                            "children": []
                        },
                        {
                            "text": "When the player logs into his/her Paradox account in Crusader Kings II, he/she will have to download the new patch.",
                            "children": []
                        },
                        {
                            "text": "If the content is not unlocked, check the following:",
                            "children": []
                        },
                        {
                            "text": "Have you connected you Paradox account and Steam Account?",
                            "children": []
                        },
                        {
                            "text": "Have you logged in to the Paradox Account in the mobile app?",
                            "children": []
                        }
                    ]
                }
            ]
        },
