{
    "pageid": 1476,
    "title": "Mythos",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Mythos is a historical fantasy mod incorporating numerous features of European, North African, and Middle Eastern myths and legends in accordance with the time period of CK2. Wherever possible it remains closer to these original myths than to modern reinterpretations, to preserve the immersion of historical grand strategy games while adding fun fantasy elements."
                }
            ]
        },
        {
            "heading": "Features",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "New religions along with rulers who start with them",
                            "children": []
                        },
                        {
                            "text": "New traits for adults and children",
                            "children": []
                        },
                        {
                            "text": "New titular titles",
                            "children": []
                        },
                        {
                            "text": "New cultures",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Character Types",
            "level": 3,
            "content": [
                {
                    "type": "paragraph",
                    "text": "The bulk of the mod is various fantasy beings, with features to make them interesting to play."
                }
            ]
        },
        {
            "heading": "Dragons",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "have dragon purity trait",
                            "children": []
                        },
                        {
                            "text": "get stronger with age",
                            "children": []
                        },
                        {
                            "text": "strong retinue, small numbers",
                            "children": []
                        },
                        {
                            "text": "extended lives",
                            "children": []
                        },
                        {
                            "text": "have their own religion",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Vampires",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "can turn prisoners into vampires",
                            "children": []
                        },
                        {
                            "text": "have their own religion",
                            "children": []
                        },
                        {
                            "text": "immortal",
                            "children": []
                        },
                        {
                            "text": "largely infertile",
                            "children": []
                        },
                        {
                            "text": "become stronger with age",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Werewolves",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "can turn prisoners into werewolves",
                            "children": []
                        },
                        {
                            "text": "immortal",
                            "children": []
                        },
                        {
                            "text": "get stronger with age",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Giants",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "unique ethnicity and culture",
                            "children": []
                        },
                        {
                            "text": "trait follows ethnicity, and thus can die out through dilution",
                            "children": []
                        },
                        {
                            "text": "much stronger infantry units, but less of them",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Zombies",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "may or may not spawn as a result of a voodoo curse",
                            "children": []
                        },
                        {
                            "text": "ruthlessly conquers everything possible",
                            "children": []
                        },
                        {
                            "text": "many troops, but no archers, cavalry, or boats, and infantry are weak",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Mummies",
            "level": 4,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "may rise up when Egypt is ruled by non-Egyptians",
                            "children": []
                        },
                        {
                            "text": "immortal",
                            "children": []
                        },
                        {
                            "text": "have their own culture and religion",
                            "children": []
                        },
                        {
                            "text": "infertile",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Characters",
            "level": 3,
            "content": [
                {
                    "type": "paragraph",
                    "text": "There are some additional characters at the earliest start, in order to populate supernatural beings and allow you to play them. They are:"
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Vlad \"the Impaler\" of Sevarin, a Vampire in Romania",
                            "children": []
                        },
                        {
                            "text": "Werewolf in Lithuania",
                            "children": []
                        },
                        {
                            "text": "Brynjolf of Norðmæri, a Giant in Norway",
                            "children": []
                        },
                        {
                            "text": "Brenin Rhodric of Deheubarth, a Wizard in Wales",
                            "children": []
                        }
                    ]
                }
            ]
        }
    ]
}