    "title": "Fosterling is Temperate",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "This character event happens 3 days after a ward has the event \" Temperate Child \"."
                }
            ]
        },
        {
            "heading": "Pre-Trigger Requirements",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Ward must have the event \" Temperate Child \""
                }
            ]
        },
        {
            "heading": "Event: Fosterling is Temperate",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "My [ward] hardly eats anything for fear of turning fat."
                }
            ]
        },
        {
            "heading": "Option A: Temperance is a virtue!",
            "level": 2,
            "content": []
        },
        {
            "heading": "Trigger Requirements",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Weight of 10 for AI (5 for temperate , 4 for diligent or celibate )",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Effects",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Ward becomes temperate",
                            "children": []
                        },
                        {
                            "text": "If character is gluttonous , lose 5 prestige",
                            "children": []
                        },
                        {
                            "text": "If character has a stewardship of 10, gain 1 stewardship",
                            "children": []
                        },
                        {
                            "text": "If character is temperate , gain 5 prestige",
                            "children": []
                        },
                        {
                            "text": "Ward gains the modified \"Happy with guardian\"",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Option B: Hold up [ward] as an example for the court!",
            "level": 2,
            "content": []
        },
        {
            "heading": "Trigger Requirements",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Weight of 10 for AI (5 for temperate , 10 for proud )",
                            "children": []
                        },
                        {
                            "text": "Any courtier is gluttonous",
                            "children": []
                        },
                        {
                            "text": "Character must NOT be gluttonous",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
