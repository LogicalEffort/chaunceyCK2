                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Harsh Tax laws require Legalism VI",
                            "children": []
                        },
                        {
                            "text": "Maximum levy laws require Legalism VII",
                            "children": []
                        }
                    ]
                },
