        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "This character event can potentially occur on the yearly childhood pulse."
                },
                {
                    "type": "paragraph",
                    "text": "Every day, the cook chases me out of the kitchen, but not before I've stuffed myself and my pockets full of biscuits."
