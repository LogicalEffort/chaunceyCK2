        {
            "heading": "About this site",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Crusader Kings II is a grand strategy game with RPG elements developed by Paradox Development Studio. This community wiki's goal is to be a repository of Crusader Kings III related knowledge, useful for both new and experienced players and for modders."
                }
            ]
        },
