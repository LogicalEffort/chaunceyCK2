    "title": "Diadochi Kings",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Diadochi Kings is a complete overhaul mod for CK2."
                },
                {
                    "type": "paragraph",
                    "text": "It takes place following the death of Alexander the Great (323 BC) and focuses on the following wars in the Mediterranean. Possible future scenarios include Cyrus the Great and Philip of Macedon."
                }
            ]
        },
        {
            "heading": "Features",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "A new map which includes the Mediterranean and Near East.",
                            "children": []
                        },
                        {
                            "text": "All new characters, titles, religions, and cultures appropriate to the new start date.",
                            "children": []
                        },
                        {
                            "text": "Many new events, decisions, and buildings that are appropriate for the ancient time period",
                            "children": []
                        },
                        {
                            "text": "A focus on historical accuracy",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
