        {
            "heading": "Version 1.7.1",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "General polishing and bugfix.",
                            "children": []
                        },
                        {
                            "text": "Mod is now compatible with version 1.07b.",
                            "children": []
                        },
                        {
                            "text": "Moved the adulthood age at 14, females get their portrait at 13 though.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Version 1.7",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "General polishing and bugfix.",
                            "children": []
                        },
                        {
                            "text": "Made all empires except from byz, hre and Persia titular.",
                            "children": []
                        },
                        {
                            "text": "New decisions to found holy orders, they are connected to the owning of provinces and your prestige.",
                            "children": []
                        },
                        {
                            "text": "Roman empire creation and events are now available also to hre, the reconquest cb is available only once you are roman emperor.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Version 1.6",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Mod is now compatible with 1.7.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
