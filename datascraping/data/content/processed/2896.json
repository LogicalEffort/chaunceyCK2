{
    "pageid": 2896,
    "title": "Character finder",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "The Character finder is a powerful tool. It can be opened by clicking a button at the bottom right of the screen, or by pressing the period key ( . )."
                }
            ]
        },
        {
            "heading": "Free text search",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "By typing into the box at the top, you can narrow the search by:"
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Given names",
                            "children": []
                        },
                        {
                            "text": "Dynasty names",
                            "children": []
                        },
                        {
                            "text": "Names of claimed titles",
                            "children": []
                        },
                        {
                            "text": "Names of artifacts",
                            "children": []
                        },
                        {
                            "text": "Traits",
                            "children": [
                                {
                                    "text": "Displayed trait names up to the first space",
                                    "children": []
                                },
                                {
                                    "text": "Internal trait names after any underscore",
                                    "children": [
                                        {
                                            "text": "For example, \"leader\" matches many leadership traits , including Unyielding because its internal name is unyielding_leader .",
                                            "children": []
                                        }
                                    ]
                                },
                                {
                                    "text": "Search for multiple traits: \"genius strong\" to jumpstart your eugenics program",
                                    "children": []
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Other fields",
            "level": 2,
            "content": [
                {
                    "type": "table",
                    "rows": [
                        [
                            "Field",
                            "Values",
                            "Notes"
                        ],
                        [
                            "Gender",
                            "Men, Women, Both",
                            ""
                        ],
                        [
                            "In prison",
                            "Yes, No, Any",
                            ""
                        ],
                        [
                            "Married",
                            "Yes, No, Any",
                            "Betrothed characters are considered married"
                        ],
                        [
                            "Ruler",
                            "Yes, No, Any",
                            ""
                        ],
                        [
                            "Diplo Range",
                            "Yes, No, Any",
                            ""
                        ],
                        [
                            "Join Court",
