                            ""
                        ],
                        [
                            "Religion",
                            "Mine, My group, Not mine, Not my group, Any, Has secret religion",
                            "Right-click another character and select \"Explore Character Opinions\" to make \"My Religion\" refer to their religion, etc"
                        ],
                        [
                            "Right-click another character and select \"Explore Character Opinions\" to make \"My Religion\" refer to their religion, etc",
                            "Culture",
                            "Mine, My group, Not mine, Not my group, Any"
                        ],
                        [
