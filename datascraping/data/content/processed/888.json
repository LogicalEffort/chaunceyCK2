        {
            "heading": "Scopes",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "For Casus Belli, inside scopes :"
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Default scope for character scopes can't be counted upon.  Use ROOT, FROM and FROMFROM explicitly to specify which character you want.",
                            "children": []
                        },
                        {
                            "text": "Default scope for title scopes is the title the war is declared over.",
                            "children": []
                        },
                        {
                            "text": "ROOT is the character who has a case for war. (for both titles and character scopes)",
                            "children": []
                        },
                        {
                            "text": "FROM is the character who is being declared war on. (for both titles and character scopes)",
                            "children": []
                        },
                        {
                            "text": "FROMFROM is the third party claimant, used in other_claim(_) Casus Belli.",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "paragraph",
                    "text": ""
                },
