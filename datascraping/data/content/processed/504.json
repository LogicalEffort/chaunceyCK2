            "level": 3,
            "content": [
                {
                    "type": "paragraph",
                    "text": "For opinion modifiers based on the following, see the corresponding page:"
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Traits",
                            "children": []
                        },
                        {
                            "text": "Succession law",
                            "children": []
                        },
                        {
                            "text": "Demesne laws",
                            "children": []
                        },
                        {
                            "text": "Realm laws",
                            "children": []
                        },
                        {
                            "text": "Crown laws",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Actions that increase opinion",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Send Gift",
                            "children": []
                        },
                        {
                            "text": "Give Artifact (you can have your local smith forge a very cheap sword that gives +15 opinion)",
                            "children": []
                        },
                        {
                            "text": "Educate Child (one of your children)",
                            "children": []
                        },
                        {
                            "text": "Build in Holding in ruler's Demesne (opinion increased immediately on the start of construction)",
                            "children": []
                        },
                        {
                            "text": "others...",
                            "children": []
                        }
                    ]
                }
            ]
        },
