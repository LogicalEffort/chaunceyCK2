        {
            "heading": "Pagans",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Rust Cultists: Centered around the veneration of Old World machinery and factories",
                            "children": []
                        },
                        {
                            "text": "Occultists: A system of beliefs based around the writings of H.P. Lovecraft",
                            "children": []
                        },
                        {
                            "text": "Revelationists: This religion is vaguely Christian, but highly distorted and having extreme emphasis on the miraculous.",
                            "children": []
                        },
                        {
                            "text": "Norse : A revival of the old Norse ways centered around Minnesota and Wisconsin that believes that the Christian god failed Old America and the their old gods can protect them where their Christian god could not.",
                            "children": []
                        },
                        {
                            "text": "Thelemic: A British cult inspired by the writings of Aleister Crowley and centered around the veneration of the Queen of England.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Native American",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Nanissáanah: Translating to \"Ghost Dance\", this is the traditional faith of the Plains Indians of the American Heartland.",
                            "children": []
                        },
                        {
                            "text": "Xhúuyee K'iigaang: Translating to \"Raven Tales\", the traditional faith of the Haida and Natives of the Pacific Northwest.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Mesoamerican",
            "level": 3,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Mictlantec: An Aztec-derived belief system that is the most similar faith to the classical Aztec religion.",
                            "children": []
                        },
                        {
                            "text": "Neomayan: A syncretic Mayan religion formed from a mix of Mayan beliefs and an assortment of outside influences.",
                            "children": []
                        },
                        {
                            "text": "Sol Invicta: An Aztec-derived belief system that revolves around the worship of a powerful sun goddess.",
                            "children": []
                        },
                        {
                            "text": "Uahomche: A Mayan-derived religion that carries on traditional Mayan beliefs with few outside influences.",
                            "children": []
                        }
                    ]
