{
    "pageid": 1964,
    "title": "Patch 1.11",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Patch 1.11 was released on August 13, 2013."
                }
            ]
        },
        {
            "heading": "Gameplay",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Added auto-invite function to plots",
                            "children": []
                        },
                        {
                            "text": "Added auto stop plot functionality under intrigue tab.",
                            "children": []
                        },
                        {
                            "text": "Added Siege leader trait",
                            "children": []
                        },
                        {
                            "text": "Added so bastard dynasties are generated when the first bastard is born.",
                            "children": []
                        },
                        {
                            "text": "Fixed so holy orders can use their special units in a defensive war where they are the primary defender.",
                            "children": []
                        },
                        {
                            "text": "Fixed CTD occurred when starting between 1184-1185",
                            "children": []
                        },
                        {
                            "text": "Fixed Duke Dafydd II of Gwynedd invalid state in history files",
                            "children": []
                        },
                        {
                            "text": "Slowed down fleet movement",
                            "children": []
                        },
                        {
                            "text": "Increased movement time for armies onto or off fleets",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Interface",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Added Favorite IP table to multiplayer menu",
                            "children": []
                        },
                        {
                            "text": "Added an approve button for laws so you can change your mind later if you initially ignored the law.",
                            "children": []
                        },
                        {
                            "text": "Fixed so you can see what characters has had a plot proposal sent to them.",
                            "children": []
                        },
                        {
                            "text": "Now support to select ship-exclusive using ALT key.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Modding",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "It's now possible to read additional data into existing landed titles in mods",
                            "children": []
                        },
                        {
                            "text": "It's now possible to read additional data into existing religions in mods",
                            "children": []
                        },
                        {
                            "text": "Added 'intermarry' parameter to religions, so you can specify if members tend to marry those of specific other religions",
                            "children": []
                        },
                        {
                            "text": "Exported EXTRA_NR_OF_CHILDREN_FOR_PLAYERS to defines",
                            "children": []
                        },
                        {
                            "text": "Fixed custom tooltip trigger and effect always returning true",
                            "children": []
                        },
                        {
                            "text": "Exported ARMY_LOAD_UNLOAD_MOVE_COST to defines",
                            "children": []
                        }
                    ]
                }
            ]
        }
    ]
}