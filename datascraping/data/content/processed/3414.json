{
    "pageid": 3414,
    "title": "Hajj event chain",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Events related to the Hajj . Next event in 12 days."
                }
            ]
        },
        {
            "heading": "Preparations events",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "All have a mtth of 24 days."
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "May invite a courtier, AI more likely to invite courtier if gregarious and/or charitable , will never accept if greedy . Cost 5% of yearly income. Both characters gain +10 Opinion (Brought on Hajj) modifier for 1000 months. May refuse if not charitable and lose 5 Piety.",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "May berate an older (at least 40 years old), not busy, not hajjaj liege to join Hajj. Not berating liege costs 5 Piety. AI more likely to berate liege if gregarious and/or zealous . AI liege more likely to accept if 50 years old or older and/or zealous and loses 5 Prestige. Vassal gains 25 Prestige if liege joins. Vassal loses 10 Prestige if liege refuses to join.",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Liege (at least 20 years old, is hajjaj ) may suggest vassal to go on Hajj. Either spend 20% yearly income to bring hajj guards, or lose 10 Pretige to travel lightly.",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Adult son wants to go with you. Accepting costs 10% yearly income and both characters gain +10 Opinion (Brought on Hajj) modifier for 1000 months. Refusing gives the son -10 Opinion (Refused Hajj) modifier for 1000 months.",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Hajj starts, travel events",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Get a Hadith event event in 30 days.\nOne event among the following with equal probability happens between 10 and 20 days."
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Bandits have attacked a fellow on hajj",
                            "children": [
                                {
                                    "text": "A Lose 20 Piety",
                                    "children": []
                                },
                                {
                                    "text": "B Gain 5 Piety, 15% chance of getting wounded",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Encountering a rival on the hajj",
                            "children": [
                                {
                                    "text": "Attack him! Lose 10 Piety, add Attempted murder (-20 Opinion) modifier for 1000 months, is considered a crime",
                                    "children": [
                                        {
                                            "text": "A 80% of wounding the rival, 20% of getting wounded otherwise",
                                            "children": []
                                        },
                                        {
                                            "text": "B 30% of wounding the rival, 60% of getting wounded , 10% of getting maimed",
                                            "children": []
                                        },
                                        {
                                            "text": "C (requires paranoid or ambitious or hajj guards) lose 5 Prestige",
                                            "children": []
                                        }
                                    ]
                                },
                                {
                                    "text": "Attempt befriend",
                                    "children": [
                                        {
                                            "text": "Breaking bread together , add Hajj rivalry mended modifier to both characters (+15 Opinion for 1000 months)",
                                            "children": []
                                        },
                                        {
                                            "text": "Does not want to reconciliate , lose 5 Prestige",
                                            "children": []
                                        }
                                    ]
                                },
                                {
                                    "text": "Do nothing lose 10 Prestige",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Lose drunkard and/or gluttonous . If neither, gain 15 Piety",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Lost in the desert",
                            "children": [
                                {
                                    "text": "Lose 1 Health, gain 25 Prestige",
                                    "children": []
                                },
                                {
                                    "text": "33% chance of becoming trusting",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Oasis",
                            "children": [
                                {
                                    "text": "Has Faith gain 15 Piety",
                                    "children": []
                                },
                                {
                                    "text": "Gives In To Despair lose 15 Piety",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Desert Mirage",
                            "children": [
                                {
                                    "text": "If not depressed , 5% chance of becoming depressed",
                                    "children": []
                                },
                                {
                                    "text": "If not possessed , 5% chance of becoming possessed",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Camels",
                            "children": [
                                {
                                    "text": "Gain 15 Piety, lose 1 Health",
                                    "children": []
                                },
                                {
                                    "text": "Lose 15 Piety",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Baggage Train gain 10 Piety",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Hashshashin (requires them to not be scattered or destroyed)",
                            "children": [
                                {
                                    "text": "Gain 10 Piety, 15% chance of getting wounded , gained saved_assassin flag",
                                    "children": []
                                },
                                {
                                    "text": "Lose 10 Piety",
                                    "children": []
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "heading": "Extra event for distant Hajj",
            "level": 3,
            "content": [
                {
                    "type": "paragraph",
                    "text": "For characters with a distance of 400 or above to Mecca gets an additional event which happens between 2 and 10 days after the start of the Hajj."
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Bandits!",
                            "children": [
                                {
                                    "text": "Attempt avoid 20% chance of of the bandits catching leading to:",
                                    "children": [
                                        {
                                            "text": "If Martial at least 14, gain 30 Prestige, 20% chance of becoming wounded",
                                            "children": []
                                        },
                                        {
                                            "text": "If Martial is below 14, hired hajj guards, gain 10 Prestige, 15% chance of becoming wounded",
                                            "children": []
                                        },
                                        {
                                            "text": "If Martial is below 14, did not hired hajj guards, 20% chance of becoming wounded",
                                            "children": []
                                        },
                                        {
                                            "text": "Lose 5% of yearly income and 10 Prestige",
                                            "children": []
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Seasick on a ship gain 5 Piety",
                            "children": []
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Christian pirates",
                            "children": [
                                {
                                    "text": "Lose 25 Prestige",
                                    "children": []
                                },
                                {
                                    "text": "Gain 25 Piety, 15% chance of becoming wounded",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Shipwrecked",
                            "children": [
                                {
                                    "text": "Shares food , gain 15 Piety, lose 1 Health",
                                    "children": []
                                },
                                {
                                    "text": "Does not share , lose 15 Piety",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Mutiny",
                            "children": [
                                {
                                    "text": "Fights Crew , gain 15 Prestige, 15% chance of becoming wounded",
                                    "children": []
                                },
                                {
                                    "text": "Sneaks Off Ship , lose 15 Prestige",
                                    "children": []
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Caravan gain 10 Prestige",
                            "children": []
                        }
                    ]
                }
            ]
        },
        {
            "heading": "The Hadiths on Hajj",
            "level": 2,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Randomly selects a Hadith, cost 1% yearly income or lose 10 Piety."
                },
                {
                    "type": "table",
                    "rows": [
                        [
                            "Removable sinful trait",
                            "Boon"
                        ],
                        [
                            "greedy",
                            "10% yearly income"
                        ],
                        [
                            "slothful",
                            "+25 Prestige"
                        ],
