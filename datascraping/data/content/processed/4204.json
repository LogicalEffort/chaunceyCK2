    "title": "Simple Slavery",
    "sections": [
        {
            "heading": "Introduction",
            "level": 1,
            "content": [
                {
                    "type": "paragraph",
                    "text": "Simple Slavery is a mod for Crusader Kings 2 that adds the economic system of Slavery in its many different forms to the game, with various associated drawbacks and advantages for its practitioners."
                }
            ]
        },
