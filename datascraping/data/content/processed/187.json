            "heading": "Changelog",
            "level": 2,
            "content": [
                {
                    "type": "list",
                    "list_type": "ul",
                    "items": [
                        {
                            "text": "Fixed a random \"freeze\" issue that could occur during normal gameplay",
                            "children": []
                        },
                        {
                            "text": "Fixed a resign CTD and related issues with Holdings not being entirely reset on resign",
                            "children": []
                        },
                        {
                            "text": "Fixed a problem with white looking terrain on certain graphics cards",
                            "children": []
                        },
                        {
                            "text": "Fixed an issue with historical characters not getting some random traits at start",
                            "children": []
                        },
                        {
                            "text": "The console command \"observe\" should no longer crash the game",
                            "children": []
                        },
                        {
                            "text": "Reverted to 1.03b version of audio code for greater compatibility with older machines",
                            "children": []
                        }
                    ]
                }
            ]
        }
    ]
